generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =========================================
// ENUMS
// =========================================

enum Role {
  ADMIN
  GURU_MAPEL
  WALI_KELAS
  KEPALA_SEKOLAH
  KOORDINATOR_KOKURIKULER
  SISWA
}

enum StatusTP {
  TERCAPAI
  TIDAK_TERCAPAI
}

enum KategoriMapel {
  UMUM
  MULOK
  PEMINATAN
}

enum Agama {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KONGHUCU
  LAINNYA
}

enum StatusDalamKeluarga {
  ANAK_KANDUNG
  ANAK_ANGKAT
  ANAK_TIRI
}

// =========================================
// AUTENTIKASI & PENGGUNA
// =========================================

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  role         Role
  fotoProfil   String?  @map("foto_profil")
  ukuranKertas String?  @default("A4") @map("ukuran_kertas")
  marginAtas   Int?     @default(20) @map("margin_atas")
  marginBawah  Int?     @default(20) @map("margin_bawah")
  marginKiri   Int?     @default(25) @map("margin_kiri")
  marginKanan  Int?     @default(20) @map("margin_kanan")
  refreshToken String?  @map("refresh_token") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  guru         Guru?
  siswa        Siswa?
  tandaTangans TandaTangan[]

  @@map("users")
}

model Guru {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  nip       String?  @unique
  nuptk     String?  @unique
  nama      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  waliKelasKelas Kelas[]     @relation("WaliKelas")
  guruMapels     GuruMapel[]

  @@map("gurus")
}

model Siswa {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  nisn      String   @unique
  nis       String?  @unique
  nama      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- Data kelahiran & identitas ---
  tempatLahir         String?              @map("tempat_lahir")
  tanggalLahir        DateTime?            @map("tanggal_lahir")
  agama               Agama?
  nik                 String?              @unique
  statusDalamKeluarga StatusDalamKeluarga? @map("status_dalam_keluarga")
  anakKe              Int?                 @map("anak_ke")

  // --- Alamat & kontak siswa ---
  alamatSiswa    String? @map("alamat_siswa") @db.Text
  noTeleponRumah String? @map("no_telepon_rumah")

  // --- Riwayat penerimaan ---
  sekolahAsal     String?   @map("sekolah_asal")
  diterimaKelas   String?   @map("diterima_kelas")
  diterimaTanggal DateTime? @map("diterima_tanggal")

  // --- Data orang tua ---
  namaAyah      String? @map("nama_ayah")
  namaIbu       String? @map("nama_ibu")
  alamatOrtu    String? @map("alamat_ortu") @db.Text
  noHpOrtu      String? @map("no_hp_ortu")
  pekerjaanAyah String? @map("pekerjaan_ayah")
  pekerjaanIbu  String? @map("pekerjaan_ibu")

  // --- Data wali (kalau ada) ---
  namaWali      String? @map("nama_wali")
  alamatWali    String? @map("alamat_wali") @db.Text
  noHpWali      String? @map("no_hp_wali")
  pekerjaanWali String? @map("pekerjaan_wali")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  riwayatKelas      RiwayatKelas[]
  nilais            Nilai[]
  nilaiEkskuls      NilaiEkskul[]
  nilaiKokurikulers NilaiKokurikuler[]
  kehadiranSiswas   KehadiranSiswa[]

  @@map("siswas")
}

// =========================================
// MASTER DATA
// =========================================

model Mapel {
  id        Int           @id @default(autoincrement())
  kode      String        @unique
  nama      String
  kategori  KategoriMapel @default(UMUM)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  guruMapels GuruMapel[]

  @@map("mapels")
}

model TahunAjaran {
  id        Int      @id @default(autoincrement())
  tahun     String // contoh: "2025/2026"
  semester  Int // 1 = ganjil, 2 = genap
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  kelas             Kelas[]
  riwayatKelas      RiwayatKelas[]
  nilaiEkskuls      NilaiEkskul[]
  nilaiKokurikulers NilaiKokurikuler[]
  kehadiranSiswas   KehadiranSiswa[]
  tandaTangans      TandaTangan[]
  pengaturanRaports PengaturanRaport[]

  @@unique([tahun, semester])
  @@map("tahun_ajarans")
}

model Kelas {
  id            Int      @id @default(autoincrement())
  tahunAjaranId Int      @map("tahun_ajaran_id")
  waliKelasId   Int?     @map("wali_kelas_id")
  nama          String // contoh: "VII-A"
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tahunAjaran  TahunAjaran    @relation(fields: [tahunAjaranId], references: [id])
  waliKelas    Guru?          @relation("WaliKelas", fields: [waliKelasId], references: [id])
  guruMapels   GuruMapel[]
  riwayatKelas RiwayatKelas[]

  @@unique([tahunAjaranId, nama])
  @@map("kelas")
}

model Ekskul {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  nilaiEkskuls NilaiEkskul[]

  @@map("ekskuls")
}

model Kokurikuler {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  nilaiKokurikulers NilaiKokurikuler[]

  @@map("kokurikulers")
}

// =========================================
// AKADEMIK
// =========================================

model GuruMapel {
  id        Int      @id @default(autoincrement())
  guruId    Int      @map("guru_id")
  mapelId   Int      @map("mapel_id")
  kelasId   Int      @map("kelas_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guru                Guru                 @relation(fields: [guruId], references: [id])
  mapel               Mapel                @relation(fields: [mapelId], references: [id])
  kelas               Kelas                @relation(fields: [kelasId], references: [id])
  tujuanPembelajarans TujuanPembelajaran[]
  nilais              Nilai[]

  @@unique([guruId, mapelId, kelasId])
  @@map("guru_mapels")
}

model RiwayatKelas {
  id            Int      @id @default(autoincrement())
  siswaId       Int      @map("siswa_id")
  kelasId       Int      @map("kelas_id")
  tahunAjaranId Int      @map("tahun_ajaran_id")
  createdAt     DateTime @default(now()) @map("created_at")

  siswa       Siswa       @relation(fields: [siswaId], references: [id])
  kelas       Kelas       @relation(fields: [kelasId], references: [id])
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])

  @@unique([siswaId, tahunAjaranId])
  @@map("riwayat_kelas")
}

model TujuanPembelajaran {
  id          Int      @id @default(autoincrement())
  guruMapelId Int      @map("guru_mapel_id")
  deskripsi   String   @db.Text
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  guruMapel GuruMapel @relation(fields: [guruMapelId], references: [id], onDelete: Cascade)
  nilaiTps  NilaiTp[]

  @@map("tujuan_pembelajarans")
}

model Nilai {
  id          Int      @id @default(autoincrement())
  siswaId     Int      @map("siswa_id")
  guruMapelId Int      @map("guru_mapel_id")
  nilaiAkhir  Float?   @map("nilai_akhir")
  deskripsi   String?  @db.Text
  isFinal     Boolean  @default(false) @map("is_final")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  siswa     Siswa     @relation(fields: [siswaId], references: [id])
  guruMapel GuruMapel @relation(fields: [guruMapelId], references: [id])
  nilaiTps  NilaiTp[]

  @@unique([siswaId, guruMapelId])
  @@map("nilais")
}

model NilaiTp {
  id        Int      @id @default(autoincrement())
  nilaiId   Int      @map("nilai_id")
  tpId      Int      @map("tp_id")
  status    StatusTP
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  nilai Nilai              @relation(fields: [nilaiId], references: [id], onDelete: Cascade)
  tp    TujuanPembelajaran @relation(fields: [tpId], references: [id])

  @@unique([nilaiId, tpId])
  @@map("nilai_tps")
}

// =========================================
// PENDUKUNG RAPORT
// =========================================

model NilaiEkskul {
  id            Int      @id @default(autoincrement())
  siswaId       Int      @map("siswa_id")
  ekskulId      Int      @map("ekskul_id")
  tahunAjaranId Int      @map("tahun_ajaran_id")
  nilai         Float?
  deskripsi     String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  siswa       Siswa       @relation(fields: [siswaId], references: [id])
  ekskul      Ekskul      @relation(fields: [ekskulId], references: [id])
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])

  @@unique([siswaId, ekskulId, tahunAjaranId])
  @@map("nilai_ekskuls")
}

model NilaiKokurikuler {
  id            Int      @id @default(autoincrement())
  siswaId       Int      @map("siswa_id")
  kokurikulerId Int      @map("kokurikuler_id")
  tahunAjaranId Int      @map("tahun_ajaran_id")
  deskripsi     String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  siswa       Siswa       @relation(fields: [siswaId], references: [id])
  kokurikuler Kokurikuler @relation(fields: [kokurikulerId], references: [id])
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])

  @@unique([siswaId, kokurikulerId, tahunAjaranId])
  @@map("nilai_kokurikulers")
}

model KehadiranSiswa {
  id              Int      @id @default(autoincrement())
  siswaId         Int      @map("siswa_id")
  tahunAjaranId   Int      @map("tahun_ajaran_id")
  sakit           Int      @default(0)
  izin            Int      @default(0)
  tanpaKeterangan Int      @default(0) @map("tanpa_keterangan")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  siswa       Siswa       @relation(fields: [siswaId], references: [id])
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])

  @@unique([siswaId, tahunAjaranId])
  @@map("kehadiran_siswas")
}

model TandaTangan {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  tahunAjaranId Int      @map("tahun_ajaran_id")
  fileTtd       String   @map("file_ttd")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id])
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])

  @@unique([userId, tahunAjaranId])
  @@map("tanda_tangans")
}

model PengaturanRaport {
  id            Int      @id @default(autoincrement())
  tahunAjaranId Int      @unique @map("tahun_ajaran_id")
  tanggal       DateTime
  tempat        String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])

  @@map("pengaturan_raports")
}
